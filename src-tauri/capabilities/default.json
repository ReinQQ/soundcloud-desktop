{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SoundCloud Desktop restricted remote capability",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://soundcloud.com/*",
      "https://*.soundcloud.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-update-discord-rpc",
    "allow-clear-discord-rpc",
    "allow-get-settings",
    "allow-save-settings",
    "allow-window-action",
    "allow-restart-app",
    "allow-check-update",
    "allow-install-update"
  ]
}
